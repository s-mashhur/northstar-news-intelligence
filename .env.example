# Runtime mode: Mock | Real
WEBZ_MODE=Mock
WEBZ_API_TOKEN=
WEBZ_BASE_URL=https://api.webz.io/

# JWT - CHANGE IN REAL DEPLOYMENTS (32+ chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# PostgreSQL
POSTGRES_DB=news_intelligence
POSTGRES_USER=newsintel
POSTGRES_PASSWORD=change-me

# Redis
REDIS_ENABLED=true

# Demo data is convenient for portfolio/demo environments.
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@newsintel.dev
DEMO_USER_PASSWORD=Demo123!
