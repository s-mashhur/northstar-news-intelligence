<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewsIntelligence.Application\NewsIntelligence.Application.csproj" />
    <ProjectReference Include="..\NewsIntelligence.Infrastructure\NewsIntelligence.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.19" />
    <!-- Explicit runtime dependency: prevents EF relational assembly from being omitted from container publish output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />
  </ItemGroup>
</Project>
